#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Optional local credential file (TEMPLATE).

Copy this to ``api_credentials.py`` (same directory) and fill in real values if
you prefer file-based credentials over environment variables. The real file is
git-ignored — never commit secrets.

Preferred alternative: leave this out entirely and set the environment variables
named in ``config.yaml`` (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY). Environment
variables take precedence over the values here.
"""

# API key for the main (Anthropic) client. Overridden by $ANTHROPIC_API_KEY.
DEFAULT_APP_KEY = "your-anthropic-api-key-here"

# Optional application/account id, if your deployment uses one. Overridden by
# $LLM_APP_ID. Leave as None if not applicable.
DEFAULT_APP_ID = None
